# פרטי מסד הנתונים הפרטי של היומן (פרויקט Supabase נפרד — "הפרויקט של אופיר")
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# התראות Web Push (תזכורות שמגיעות גם כשהיומן סגור)
# צור מפתחות עם: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# סוד משותף בין ה-cron של Supabase לנתיב השרת (מחרוזת אקראית)
CRON_SECRET=your-random-secret

# התראות במייל (אופציונלי) — בלי המפתח נשלחות רק התראות פוש
# מפתח מ-resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxx
ALERT_EMAIL_TO=ofirpahima12@gmail.com
# ברירת מחדל: onboarding@resend.dev. לשליחה לכתובת חיצונית יש לאמת דומיין ב-Resend
RESEND_FROM=יומן המשימות <onboarding@resend.dev>

# טלגרם — התראות חינם שקופצות בטלפון (מומלץ). טוקן מ-@BotFather → /newbot
TELEGRAM_BOT_TOKEN=123456789:AA...

# SMS דרך Twilio — אופציונלי ובתשלום. בלי שלושת אלה ה-SMS כבוי ולא מוצג ביומן
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# מספר Twilio שקניתם (+1...) או שם שולח באותיות לועזיות עד 11 תווים
# TWILIO_FROM=Yoman
# (אופציונלי) במקום TWILIO_FROM: Messaging Service
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# (אופציונלי) סוד להצפנת מספרי הטלפון. ברירת מחדל: CRON_SECRET
# SMS_SECRET=random-string


# (אופציונלי) כתובת האתר לקישורים בהתראות. ברירת מחדל: כתובת הפרודקשן של Vercel
# APP_URL=https://ofir-task-journal.vercel.app
